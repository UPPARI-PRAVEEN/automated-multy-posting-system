# Mastodon: create an application token with write:statuses permission.
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
MASTODON_CLIENT_SECRETE=
MASTODON_KEY =
MASTODON_VISIBILITY=public

# Bluesky: use an app password, not your account password.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# Telegram: add the bot as an administrator if posting to a channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUBLIC_CHANNEL=

# DEV: generate an API key from your DEV account settings.
DEVTO_API_KEY=
DEVTO_ARTICLE_TITLE=New update
